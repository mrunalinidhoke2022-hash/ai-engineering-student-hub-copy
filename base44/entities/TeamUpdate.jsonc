{
  "name": "TeamUpdate",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "team_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "update",
        "joined",
        "left",
        "roadmap_shared"
      ],
      "default": "update"
    },
    "message": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "team_id",
    "message"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}