{
  "name": "TaskComment",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "team_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "team_members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "team_id",
    "task_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.team_members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.team_members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}