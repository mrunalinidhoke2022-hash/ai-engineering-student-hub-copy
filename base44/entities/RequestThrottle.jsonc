{
  "name": "RequestThrottle",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "key_hash": {
      "type": "string"
    },
    "bucket": {
      "type": "string"
    },
    "window_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key_hash",
    "bucket"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}