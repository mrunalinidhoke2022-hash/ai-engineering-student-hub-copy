{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "account_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "name_key": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "email_key": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "mobile_key": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "mobile_verified": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "suspended"
      ],
      "default": "active"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "account_id",
    "user_id",
    "full_name",
    "email",
    "mobile"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.account_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}