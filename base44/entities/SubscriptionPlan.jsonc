{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 60
    },
    "slug": {
      "type": "string",
      "maxLength": 40
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "student",
        "pro",
        "pass"
      ]
    },
    "tagline": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 1200
    },
    "currency": {
      "type": "string",
      "maxLength": 8,
      "default": "INR"
    },
    "price_monthly": {
      "type": "number",
      "default": 0
    },
    "price_yearly": {
      "type": "number",
      "default": 0
    },
    "price_one_time": {
      "type": "number",
      "default": 0
    },
    "billing_cycles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "free",
          "monthly",
          "yearly",
          "one_time"
        ]
      }
    },
    "duration_days": {
      "type": "number",
      "default": 0
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_key": {
            "type": "string"
          },
          "daily_limit": {
            "type": "number"
          },
          "monthly_limit": {
            "type": "number"
          }
        }
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "razorpay_plan_id_monthly": {
      "type": "string",
      "maxLength": 80
    },
    "razorpay_plan_id_yearly": {
      "type": "string",
      "maxLength": 80
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "name",
    "slug",
    "tier"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}