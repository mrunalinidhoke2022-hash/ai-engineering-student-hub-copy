{
  "name": "CodingProblem",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "C",
        "C++",
        "Java",
        "Python",
        "JavaScript",
        "HTML",
        "CSS",
        "SQL"
      ]
    },
    "topic": {
      "type": "string",
      "enum": [
        "Programming Basics",
        "Variables",
        "Conditions",
        "Loops",
        "Functions",
        "Arrays",
        "Strings",
        "OOP",
        "Data Structures",
        "Algorithms",
        "DBMS",
        "Web Development"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Beginner",
        "Easy",
        "Medium",
        "Hard"
      ]
    },
    "problem": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "example_input": {
      "type": "string"
    },
    "example_output": {
      "type": "string"
    },
    "hint": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "solution_explanation": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "language",
    "topic",
    "difficulty",
    "problem"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}