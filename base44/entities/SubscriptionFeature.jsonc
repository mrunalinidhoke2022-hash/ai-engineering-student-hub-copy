{
  "name": "SubscriptionFeature",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "maxLength": 60
    },
    "plan_slug": {
      "type": "string",
      "maxLength": 40
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "free",
        "student",
        "pro",
        "pass"
      ]
    },
    "feature_key": {
      "type": "string",
      "maxLength": 60
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "daily_limit": {
      "type": "number",
      "default": -1
    },
    "monthly_limit": {
      "type": "number",
      "default": -1
    },
    "limit_label": {
      "type": "string",
      "maxLength": 80
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "plan_slug",
    "feature_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}