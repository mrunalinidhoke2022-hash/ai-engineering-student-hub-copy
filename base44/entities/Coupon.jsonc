{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "maxLength": 40
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "flat"
      ],
      "default": "percent"
    },
    "discount_value": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "maxLength": 8,
      "default": "INR"
    },
    "applies_to_plan_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applies_to_cycles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "monthly",
          "yearly",
          "one_time"
        ]
      }
    },
    "min_amount": {
      "type": "number",
      "default": 0
    },
    "max_uses": {
      "type": "number",
      "default": 0
    },
    "max_uses_per_user": {
      "type": "number",
      "default": 1
    },
    "used_count": {
      "type": "number",
      "default": 0
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_by_name": {
      "type": "string",
      "maxLength": 160
    },
    "notes": {
      "type": "string",
      "maxLength": 400
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}